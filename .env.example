# Supabase project URL from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase publishable key used only in browser-safe code
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Supabase secret key; server-only and never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Google Maps browser key restricted to your allowed domains
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# PayHere merchant identifier
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
# PayHere secret used to verify webhook signatures on the server
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
# Public PayHere checkout identifier
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=your_payhere_merchant_id
# Resend API key used only by server-side email code
RESEND_API_KEY=your_resend_api_key
# Canonical public website address
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number in international digits with no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=94770000000
